{
  "manifest_version": 3,
  "name": "Molt — New Tab Dashboard",
  "version": "1.0.0",
  "description": "Shed your old tabs. A local-first dashboard of all your open tabs — search, mute, snapshot & restore. No account, no tracking.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Molt — open dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Open the Molt dashboard"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
