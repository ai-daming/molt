{
  "manifest_version": 3,
  "name": "Molt",
  "version": "1.0.0",
  "description": "Shed your old tabs. A new-tab dashboard of everything you have open — grouped by domain, searchable, with audio finding, session snapshots, and satisfying closes. 100% local.",
  "permissions": ["tabs", "activeTab", "storage"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Molt — open dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Open the Molt dashboard"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
