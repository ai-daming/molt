{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_moltName__",
  "version": "1.0.0",
  "description": "__MSG_moltDescription__",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "tabGroups"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_moltActionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_cmdOpenDashboard__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
